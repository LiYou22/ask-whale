{
  "name": "ask-whale",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "generate": "node scripts/build-knowledge.mjs && pnpm run generate:fast",
    "generate:fast": "node scripts/build-page.mjs && node scripts/vendor.mjs",
    "dev": "pnpm run generate && wrangler dev",
    "deploy": "pnpm run generate && wrangler deploy",
    "deploy:fast": "pnpm run generate:fast && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "cloudflare": {
    "bindings": {
      "ANTHROPIC_API_KEY": {
        "description": "Claude API key from console.anthropic.com. Set a spend limit on that organization."
      },
      "TURNSTILE_SECRET": {
        "description": "Secret key of a Turnstile widget (Cloudflare dashboard → Turnstile) whose hostname is this Worker's workers.dev address."
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
